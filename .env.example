# Copy this file to .env

# Which model reads documents and plans the agent's actions:
#   ollama  - local open-weight model, free, data never leaves the machine (recommended)
#   gemini  - Google AI Studio free tier
#   groq    - Groq free tier
#   cached  - no model: replay recorded outputs (used on the hosted demo)
LLM_PROVIDER=ollama

# Ollama (install from ollama.com, then: ollama pull qwen2.5:3b && ollama pull qwen2.5vl:3b)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT=600

# Gemini (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 1 = reuse recorded model outputs where they exist; call the model only for new steps
PREFER_RECORDED=0

# Max clarification rounds before escalating to a human
MAX_CLARIFY_ROUNDS=3
