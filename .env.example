# Copy this file to .env and fill in what you have.
# With LLM_PROVIDER=cached the app needs no key at all.

# One of: gemini | groq | cached
LLM_PROVIDER=cached

# Free key from Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Free key from console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Max clarification rounds before escalating to a human
MAX_CLARIFY_ROUNDS=3
